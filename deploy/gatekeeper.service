[Unit]
Description=Gatekeeper Edge Vehicle Tracking Appliance
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/gatekeeper
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStartPre=/opt/gatekeeper/deploy/compose.sh pull --ignore-build-errors
ExecStart=/opt/gatekeeper/deploy/compose.sh up --remove-orphans
ExecStop=/opt/gatekeeper/deploy/compose.sh down
Restart=always
RestartSec=10s
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
